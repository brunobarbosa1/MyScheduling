# ==========================================================
# Template de variáveis de ambiente do MyScheduling.
# Copie para .env e preencha os valores: cp .env.example .env
# O arquivo .env real é ignorado pelo git e NÃO deve ser commitado.
# ==========================================================

# PostgreSQL
POSTGRES_USER=myscheduling
POSTGRES_PASSWORD=
POSTGRES_DB=myscheduling
POSTGRES_PORT=5432

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
